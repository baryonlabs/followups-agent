# OpenRouter 추론용 키 (관리용 management 키는 모델 호출 불가)
OPENROUTER_API_KEY=sk-or-v1-...
# 로컬 Langfuse (infra/.env의 LANGFUSE_INIT_PROJECT_* 값과 같게)
LANGFUSE_PUBLIC_KEY=pk-lf-followups-local
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=http://localhost:3100
MODEL_MAIN=anthropic/claude-sonnet-5.5
MODEL_FAST=anthropic/claude-haiku-5.5
MAIN_REASONING_EFFORT=low
