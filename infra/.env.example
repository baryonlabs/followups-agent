# 생성: 아래 값을 openssl로 만들어 infra/.env 에 저장
#   echo "LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-$(openssl rand -hex 16)" ...
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-followups-local
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-CHANGE_ME
LANGFUSE_INIT_USER_PASSWORD=CHANGE_ME
NEXTAUTH_SECRET=CHANGE_ME          # openssl rand -hex 24
SALT=CHANGE_ME                     # openssl rand -hex 16
ENCRYPTION_KEY=CHANGE_ME           # openssl rand -hex 32 (64 hex)
